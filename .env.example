# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-new-random-secret
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
LANGUAGE_CODE=my
TIME_ZONE=Asia/Yangon
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (use a unique password outside local development)
DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=replace-with-a-unique-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Reverse-proxy security. Enable after TLS is configured.
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Public app entrypoint
APP_PORT=8080
