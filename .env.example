# ERP01 Django application
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=generate-a-random-secret-at-least-50-characters-and-share-only-with-trusted-services
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,web
LANGUAGE_CODE=my
TIME_ZONE=Asia/Yangon
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (one private instance shared by Django and Finance module)
DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=replace-with-a-unique-long-database-password
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Redis (private Compose network only)
REDIS_URL=redis://redis:6379/0

# Frontend entrypoint
APP_PORT=8080

# Optional ARIMA-style gateway + extracted Finance service
GATEWAY_PORT=8001
MODULES_ENABLED=inventory,sales,core,finance
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-a-unique-grafana-password

# Operations and monitoring
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
