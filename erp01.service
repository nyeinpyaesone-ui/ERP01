[Unit]
Description=ERP01 Enterprise Resource Planning System
After=network.target

[Service]
Type=notify
User=erp01
Group=erp01
WorkingDirectory=/opt/erp01
Environment="PATH=/opt/erp01/venv/bin"
ExecStart=/opt/erp01/venv/bin/gunicorn --config gunicorn.conf.py web:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/erp01/data

[Install]
WantedBy=multi-user.target
